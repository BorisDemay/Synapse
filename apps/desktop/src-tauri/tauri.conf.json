{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synapse",
  "version": "0.1.0",
  "identifier": "org.synapse.desktop",
  "build": {
    "beforeBuildCommand": "pnpm --filter @synapse/desktop build",
    "beforeDevCommand": "pnpm --filter @synapse/desktop dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Synapse",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
