#!/usr/bin/env bash
set -euo pipefail

case "${SSH_ORIGINAL_COMMAND:-}" in
  "scp -t incoming/"|"scp -t incoming")
    exec /usr/bin/scp -t "${SYNAPSE_DEPLOY_ROOT:-/mnt/nas1/synapse}/incoming"
    ;;
esac

read -r command version sha extra <<<"${SSH_ORIGINAL_COMMAND:-}"
if [[ "$command" != "synapse-deploy" || -n "${extra:-}" ]]; then
  echo "command not allowed" >&2
  exit 126
fi
[[ "$version" =~ ^0\.1\.[0-9]+$ ]] || { echo "invalid version" >&2; exit 2; }
[[ "$sha" =~ ^[0-9a-f]{40,64}$ ]] || { echo "invalid SHA" >&2; exit 2; }
exec sudo -n /usr/local/sbin/synapse-deploy "$version" "$sha"
