# Loopback-only development/test settings. Never expose this configuration
# through a public interface.
SYNAPSE_HTTP_PORT=18090
SYNAPSE_HTTP_BIND=127.0.0.1
SYNAPSE_HTTPS_PORT=18443
SYNAPSE_HTTPS_BIND=127.0.0.1
SYNAPSE_PUBLIC_HOST=localhost
SYNAPSE_CADDYFILE=Caddyfile.development
SYNAPSE_ALLOWED_ORIGIN=http://127.0.0.1:18090
SYNAPSE_ALLOW_PUBLIC_SIGNUP=true
SYNAPSE_COOKIE_SECURE=false
SYNAPSE_ENV=development
SYNAPSE_DEV_FIXTURE=true
SYNAPSE_TRUSTED_PROXIES=
RUST_LOG=info
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse
SYNAPSE_BOOTSTRAP_ADMIN_EMAIL=
SYNAPSE_BOOTSTRAP_ADMIN_PASSWORD=
