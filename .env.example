# Public HTTPS entry point. Configure the actual host name in production.
SYNAPSE_HTTP_PORT=8080
SYNAPSE_HTTP_BIND=127.0.0.1
SYNAPSE_HTTPS_PORT=443
SYNAPSE_HTTPS_BIND=0.0.0.0
SYNAPSE_PUBLIC_HOST=notes.example.com
SYNAPSE_CADDYFILE=Caddyfile
# Optional RFC 3339 timestamp published by the backup job for /health/storage.
SYNAPSE_LAST_BACKUP_AT=

# Browser origin allowlisted for CSRF/CORS (must match how users open the UI).
SYNAPSE_ALLOWED_ORIGIN=https://notes.example.com

# Secure production defaults. Use .env.development.example only for loopback tests.
SYNAPSE_ALLOW_PUBLIC_SIGNUP=false
SYNAPSE_COOKIE_SECURE=true
SYNAPSE_ENV=production
SYNAPSE_DEV_FIXTURE=false
# Comma-separated proxy CIDRs. Leave empty when clients connect directly.
SYNAPSE_TRUSTED_PROXIES=
RUST_LOG=info

# PostgreSQL (Compose service credentials)
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse

# Optional first admin bootstrap. Required to create the first production user.
SYNAPSE_BOOTSTRAP_ADMIN_EMAIL=
SYNAPSE_BOOTSTRAP_ADMIN_PASSWORD=

# Direct server settings when running outside Compose
SYNAPSE_BIND_ADDR=127.0.0.1:3000
# Full Compose stack (docker-compose.yml) uses the credentials above on the internal network.
# Interactive `just serve` / `just dev` / cargo run must use synapse_dev — cargo tests wipe synapse_test.
# SYNAPSE_DATABASE_URL=postgres://postgres@127.0.0.1:55432/synapse_dev
SYNAPSE_DATABASE_URL=postgres://synapse:synapse@127.0.0.1:5432/synapse
SYNAPSE_STORAGE_PATH=./synapse-blobs
