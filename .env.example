# Public HTTP port published by Caddy
SYNAPSE_HTTP_PORT=8080

# Browser origin allowlisted for CSRF/CORS (must match how users open the UI)
SYNAPSE_ALLOWED_ORIGIN=http://127.0.0.1:8080

# Development-friendly defaults for local Compose; set secure values in production
SYNAPSE_ALLOW_PUBLIC_SIGNUP=true
SYNAPSE_COOKIE_SECURE=false
SYNAPSE_ENV=development
RUST_LOG=info

# PostgreSQL (Compose service credentials)
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse

# Optional first admin bootstrap (leave empty when using public signup locally)
SYNAPSE_BOOTSTRAP_ADMIN_EMAIL=
SYNAPSE_BOOTSTRAP_ADMIN_PASSWORD=

# Direct server settings when running outside Compose
SYNAPSE_BIND_ADDR=127.0.0.1:3000
SYNAPSE_DATABASE_URL=postgres://synapse:synapse@127.0.0.1:5432/synapse
SYNAPSE_STORAGE_PATH=./synapse-blobs
