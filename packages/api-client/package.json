    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "jsdom": "25.0.1",
    "prettier": "3.5.3",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  }
}
